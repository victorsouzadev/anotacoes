{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Anthropic": {
    "ApiKey": "",
    "Model": "claude-sonnet-5",
    "ApiVersion": "2023-06-01",
    "BaseUrl": "https://api.anthropic.com/v1/messages",
    "MaxTokens": 1024,
    "TimeoutSegundos": 20,
    "MaxTentativas": 2
  },
  "OpenRouter": {
    "ApiKey": "",
    "Model": "anthropic/claude-haiku-4.5",
    "BaseUrl": "https://openrouter.ai/api/v1/chat/completions",
    "MaxTokens": 4096,
    "TimeoutSegundos": 30,
    "TimeoutComAnexosSegundos": 120,
    "MaxTentativas": 2
  },
  "Llm": {
    "Provider": ""
  },
  "Extracao": {
    "LimiarConfianca": 0.6,
    "MaxDiasNoFuturo": 370
  },
  "Financas": {
    "FusoHorario": "America/Sao_Paulo",
    "MaxTamanhoTexto": 500
  }
}
