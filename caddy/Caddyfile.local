# Versão para teste local do compose (sem TLS): http://localhost:8080
#
# Dois sites no mesmo Caddy:
#   - <slug>.<SITES_DOMINIO>  → os sistemas publicados pela ferramenta "Publicar"
#   - qualquer outro host     → o notas (hub + /api), como sempre foi
:8080 {
    encode zstd gzip

    # Ferramenta "Segundo Cérebro" (cerebro/README.md) e MCP de operação (/ops). Só por HTTPS: a senha do WebDAV,
    # o token do MCP e as notas não podem passar em texto puro. O HTTPS vem do
    # nginx-proxy-manager (subdomínio → notas-caddy:8080), que manda X-Forwarded-Proto.
    # No teste local, CEREBRO_PERMITIR_HTTP=sim libera o HTTP.
    @cerebro_sem_tls {
        path /cerebro /cerebro/* /dav /dav/* /ops /ops/* /api/mcp /api/mcp/*
        not path /cerebro/health /ops/health
        expression `{http.request.header.X-Forwarded-Proto} != "https" && "{$CEREBRO_PERMITIR_HTTP:nao}" != "sim"`
    }
    handle @cerebro_sem_tls {
        respond "Use o endereço HTTPS do Segundo Cérebro." 403
    }

    # Ferramenta "Anotação": relatos policiais reais do mestrado, também só por HTTPS.
    @anotacao_sem_tls {
        path /api/anotacao /api/anotacao/*
        expression `{http.request.header.X-Forwarded-Proto} != "https" && "{$CEREBRO_PERMITIR_HTTP:nao}" != "sim"`
    }
    handle @anotacao_sem_tls {
        respond "Use o endereço HTTPS do hub." 403
    }

    # Rotas internas do cerebro (ex.: conferência do login do WebDAV) não saem para a internet.
    handle /cerebro/internal/* {
        respond 404
    }

    # API, MCP (/cerebro/mcp) e bookmarklet. O prefixo sai antes de chegar ao serviço.
    handle_path /cerebro/* {
        reverse_proxy cerebro:8080 {
            flush_interval -1
        }
    }

    # MCP de operação da VPS (ops/README.md), no mesmo HTTPS obrigatório acima.
    handle_path /ops/* {
        reverse_proxy ops:8080 {
            flush_interval -1
        }
    }

    # WebDAV do Obsidian (Remotely Save). O Obsidian roda num webview: desktop usa
    # app://obsidian.md, iPhone capacitor://localhost e Android http://localhost.
    handle /dav* {
        @obsidian header_regexp Origin ^(app://obsidian\.md|capacitor://localhost|http://localhost)$
        header @obsidian {
            Access-Control-Allow-Origin {http.request.header.Origin}
            Access-Control-Allow-Methods "GET, HEAD, PUT, POST, DELETE, OPTIONS, PROPFIND, PROPPATCH, MKCOL, COPY, MOVE, LOCK, UNLOCK"
            Access-Control-Allow-Headers "Authorization, Content-Type, Depth, Destination, Overwrite, If, If-Match, If-None-Match, Lock-Token, Timeout, Cache-Control, X-Requested-With"
            Access-Control-Expose-Headers "DAV, ETag, Content-Length, Content-Type, Last-Modified, Location"
            Access-Control-Max-Age "86400"
            Vary Origin
        }
        @preflight {
            method OPTIONS
            header Access-Control-Request-Method *
        }
        respond @preflight 204
        # O login é conferido no cerebro (a senha pode ser trocada pela tela); o rclone não tem senha.
        @precisa_login not method OPTIONS
        forward_auth @precisa_login cerebro:8080 {
            uri /internal/webdav-auth
        }
        reverse_proxy cerebro-webdav:8080
    }

    handle /api/* {
        reverse_proxy api:8080 {
            flush_interval -1
        }
    }

    # Instalador do programa Windows: fica fora da imagem (tem centenas de MB e
    # muda sem novo deploy do site). O workflow "Desktop (Windows)" grava em
    # /opt/notas-vps/downloads/windows, montado aqui (ver docker-compose.yml).
    # É também de onde o programa instalado busca as atualizações.
    handle /downloads/windows/* {
        root * /srv-downloads
        @json path *.json
        header @json Cache-Control "no-cache"
        @exe path *.exe
        header @exe Content-Disposition "attachment"
        file_server
    }

    # Craft apps do Estúdio (build web em WebAssembly), gravados pelo workflow "Craft apps" em
    # /opt/notas-vps/downloads/crafts/<app>. Ficam fora da imagem (o EffectCraft sozinho passa de
    # 50 MB) e vêm já comprimidos (.br/.gz ao lado de cada arquivo), para o Caddy não gastar CPU
    # comprimindo o .wasm a cada visita. O hub abre cada um num iframe do mesmo endereço.
    handle_path /crafts/* {
        root * /srv-downloads/downloads/crafts
        @app path_regexp app ^/([a-z]+)/
        header @app X-Craft-App {re.app.1}
        # Sem hash no nome (index.html, builds do xtask): revalida a cada visita (304 barato).
        # Com hash do Trunk (app-0123456789abcdef_bg.wasm): nunca muda, cache longo.
        header ?Cache-Control "no-cache"
        @fixo path_regexp -[0-9a-f]{16}(_bg)?\.(wasm|js|css)$
        header @fixo Cache-Control "public, max-age=31536000, immutable"
        @wasm path *.wasm
        header @wasm Content-Type "application/wasm"
        file_server {
            precompressed br gzip
        }
    }

    # APK do app Dieta, gravado pelo workflow "Android (Dieta)" em /opt/notas-vps/downloads/android.
    handle /downloads/android/* {
        root * /srv-downloads
        @json path *.json
        header @json Cache-Control "no-cache"
        @apk path *.apk
        header @apk Content-Type "application/vnd.android.package-archive"
        file_server
    }

    handle {
        root * /srv
        try_files {path} /index.html
        file_server
    }
}

# Ferramenta "Publicar": cada site enviado responde em <slug>.<SITES_DOMINIO>. O sslip.io
# resolve qualquer "<nome>.191-252-177-244.sslip.io" para o IP da VPS, então não há
# DNS para configurar. Este bloco é fixo: site novo não exige recarregar o Caddy.
#
# O disco (montado em /srv-sites) é mantido pela API: /srv-sites/<slug>/current aponta
# para a versão no ar, com web/ (front) e api/ (a DLL, que roda no container site-<slug>).
# Ver docs/poc-multi-app/DISCOVERY.md.
http://*.{$SITES_DOMINIO:191-252-177-244.sslip.io}:8080 {
    encode zstd gzip

    # O slug é o primeiro rótulo do host.
    map {host} {site} {
        ~^([a-z0-9-]+)\. "${1}"
        default "-"
    }

    # 1) /api/* é sempre do app C#.
    @api path /api /api/*
    handle @api {
        reverse_proxy site-{site}:8080
    }

    # 2) Arquivo que existe no front publicado.
    @arquivo file {
        root /srv-sites/{site}/current/web
        try_files {path}
    }
    handle @arquivo {
        root * /srv-sites/{site}/current/web
        file_server
    }

    # 3) Rota de SPA (Angular/React): cai no index.html do front.
    @spa file {
        root /srv-sites/{site}/current/web
        try_files /index.html
    }
    handle @spa {
        root * /srv-sites/{site}/current/web
        rewrite * /index.html
        file_server
    }

    # 4) Sem front publicado: o app C# atende tudo (ele pode servir o próprio wwwroot).
    handle {
        reverse_proxy site-{site}:8080
    }

    handle_errors 502 503 504 {
        header Content-Type "text/plain; charset=utf-8"
        respond "Este app não está no ar agora." {err.status_code}
    }
}
