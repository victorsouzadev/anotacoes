<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net9.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <!-- Compila (sem rodar) também no Linux, pro CI checar o código. -->
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>EditorImagens</AssemblyName>
    <RootNamespace>EditorImagens.Desktop</RootNamespace>
    <ApplicationIcon>icone.ico</ApplicationIcon>
    <Version>1.0.0</Version>
    <Product>Editor de Imagens</Product>
    <RuntimeIdentifier Condition="'$(RuntimeIdentifier)' == ''">win-x64</RuntimeIdentifier>
    <SatelliteResourceLanguages>pt-BR</SatelliteResourceLanguages>
  </PropertyGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
    <PackageReference Include="Microsoft.ML.OnnxRuntime.DirectML" Version="1.24.4" />
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.4191.47" />
    <PackageReference Include="Velopack" Version="1.2.158" />
  </ItemGroup>

  <ItemGroup>
    <!-- A API é uma biblioteca aqui: compila sem RID, igual à referência que vem
         pelo EditorImagens.Ia. Senão ela sai duas vezes no publish (com e sem
         win-x64) e o SDK recusa os arquivos repetidos (NETSDK1152). -->
    <ProjectReference Include="../../../backend/Notas.Api/Notas.Api.csproj" GlobalPropertiesToRemove="RuntimeIdentifier;SelfContained" />
    <ProjectReference Include="../EditorImagens.Ia/EditorImagens.Ia.csproj" />
  </ItemGroup>

  <!-- De onde o programa instalado busca atualização (o CI passa o endereço do site). -->
  <ItemGroup Condition="'$(UpdateUrl)' != ''">
    <AssemblyMetadata Include="UpdateUrl" Value="$(UpdateUrl)" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="icone.ico" />
    <!-- O Angular compilado e os modelos de IA entram no pacote pelo CI (ver
         .github/workflows/desktop.yml); aqui só são copiados se existirem. -->
    <None Include="wwwroot/**" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <None Include="modelos/**" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>

  <!-- Fora do instalador: símbolos de bibliotecas de terceiros (o do Skia tem
       80 MB), a camada de debug do DirectML, o .lib de link, o executável
       próprio da API (aqui ela é biblioteca) e a config de desenvolvimento
       dela (que tem um segredo de dev). -->
  <Target Name="EnxugarPublish" AfterTargets="Publish">
    <Delete Files="$(PublishDir)libSkiaSharp.pdb;$(PublishDir)DirectML.pdb;$(PublishDir)DirectML.Debug.dll;$(PublishDir)DirectML.Debug.pdb;$(PublishDir)onnxruntime.lib;$(PublishDir)Notas.Api.exe;$(PublishDir)Notas.Api;$(PublishDir)appsettings.Development.json" />
  </Target>

</Project>
