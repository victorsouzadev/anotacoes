# Versão da VPS: o dotnet publish roda no GitHub Actions (job build-cerebro) e chega em
# cerebro/publish. Aqui só a imagem de execução. Contexto de build: a pasta cerebro/.
FROM mcr.microsoft.com/dotnet/aspnet:10.0
RUN apt-get update \
    && apt-get install -y --no-install-recommends git tzdata ca-certificates \
    && rm -rf /var/lib/apt/lists/*
WORKDIR /app
COPY publish/ .
ENV ASPNETCORE_HTTP_PORTS=8080 \
    HOME=/tmp \
    DOTNET_SYSTEM_GLOBALIZATION_INVARIANT=false
EXPOSE 8080
USER $APP_UID
ENTRYPOINT ["dotnet", "Hub.dll"]
