<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <PackageId>Hub.Plugin.Sdk</PackageId>
    <!-- Mudar a versão publica um pacote novo (.github/workflows/pacotes.yml). -->
    <Version>1.2.0</Version>
    <Description>SDK dos plug-ins do hub notas-vps: login do núcleo (JWKS), health, banco compartilhado, MCP, IA e segredos.</Description>
    <Authors>victorsouzadev</Authors>
    <RepositoryUrl>https://github.com/victorsouzadev/anotacoes</RepositoryUrl>
  </PropertyGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="9.0.3" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite" Version="9.0.3" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Hub.Plugin.Sdk.Tests" />
  </ItemGroup>

</Project>
