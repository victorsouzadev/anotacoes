# Copiar para .env (chmod 600 na VPS) e preencher.
JWT_SECRET=

# Ferramenta "Finanças": chave da OpenRouter (openrouter.ai), o mesmo provedor que
# o app Android já usa. Sem nenhuma chave, o servidor cai no extrator heurístico
# local, que só interpreta texto — importar foto de cupom ou PDF de extrato exige
# uma chave.
OPENROUTER_API_KEY=

# Alternativa: chamar a API da Anthropic direto, sem passar pela OpenRouter.
# Este caminho não lê imagens nem PDFs.
ANTHROPIC_API_KEY=

# Força um provedor específico: openrouter | anthropic | heuristico.
# Vazio = usa a primeira chave configurada acima.
LLM_PROVIDER=

# Ferramenta "Publicar" (docs/poc-multi-app/DISCOVERY.md): envia um ZIP e ganha uma URL
# em <slug>.<SITES_DOMINIO>. Só os e-mails abaixo (separados por vírgula) publicam.
PUBLICADORES=
# Sites com API C# rodam em containers criados pelo serviço "deployer". Liga o serviço:
COMPOSE_PROFILES=publicar
# Token que a API usa para falar com o deployer: openssl rand -hex 32
DEPLOYER_TOKEN=
# Postgres compartilhado: cada site pode ter banco + usuário + senha próprios, criados
# pela tela. Esta é a senha do superusuário "postgres" (só a API usa): openssl rand -hex 32
POSTGRES_SENHA=
# Opcionais (padrões: 191-252-177-244.sslip.io, 8090, /opt/notas-vps/data/sites)
# SITES_DOMINIO=
# SITES_PORTA=
# SITES_HOST_DIR=

# Ferramenta "Segundo Cérebro" (cerebro/README.md): vault do Obsidian na VPS.
# Ligue somando "cerebro" ao COMPOSE_PROFILES acima (ex.: COMPOSE_PROFILES=publicar,cerebro).
# Exige HTTPS: crie no nginx-proxy-manager um Proxy Host (subdomínio → notas-caddy:8080,
# com Let's Encrypt). Por HTTP (IP:8090) o Caddy recusa /cerebro e /dav.
# E-mails do hub com acesso à tela (separados por vírgula). O vault é de uma pessoa só.
CEREBRO_USUARIOS=

# Ferramenta "Anotação" (aprovação das pré-anotações do Claude nos relatos do mestrado).
# E-mails do hub que podem ver os relatos. Vazio = ninguém. Só funciona por HTTPS e com
# um lote em data/anotacao (enviado pelo llm-ner-pipeline: scripts/claude_proposals.py).
ANOTACAO_USUARIOS=
# Pasta remota do Remotely Save (padrão: nome do vault no Obsidian)
CEREBRO_VAULT=Cerebro
# WebDAV do Obsidian (Remotely Save → https://<subdominio>/dav)
CEREBRO_WEBDAV_USER=
CEREBRO_WEBDAV_PASS=
# MCP em https://<subdominio>/cerebro/mcp: openssl rand -hex 32. Vazio = MCP desligado.
CEREBRO_MCP_TOKEN=
# API keys por fonte (vazio = fonte desligada): openssl rand -hex 32
CEREBRO_API_KEY_CELULAR=
CEREBRO_API_KEY_WHATSAPP=
CEREBRO_API_KEY_NAVEGADOR=
# A IA da Inbox se configura na tela do Cérebro (aba Configurações: OpenRouter ou Anthropic,
# modelo e chave). Sem nada na tela, usa ANTHROPIC_API_KEY e depois OPENROUTER_API_KEY lá de cima.
# Tokens do MCP, login do WebDAV e API keys também podem ser gerados na tela (aba Conectar),
# substituindo os valores abaixo. Opcionais:
# CEREBRO_MODELO=claude-haiku-5-5
# CEREBRO_OPENAI_API_KEY=        (transcrição de áudio)
# CEREBRO_AUTO_MOVER=false       (true = links vão para 30-Recursos sem aprovação)
# CEREBRO_PUID=1000              (dono dos arquivos do vault no host: id -u / id -g)
# CEREBRO_PGID=1000

# MCP de operação da VPS (ops/README.md): shell de ROOT no host, logs e restart de
# qualquer container. Quem tem este token controla a VPS inteira. Ligue somando "ops"
# ao COMPOSE_PROFILES. Mínimo de 32 caracteres: openssl rand -hex 32
# Endereço: https://<subdominio>/ops/mcp (só por HTTPS, como o Segundo Cérebro).
OPS_MCP_TOKEN=
