{
  "name": "Segundo Cérebro",
  "short_name": "Cérebro",
  "description": "Captura rápida para o Segundo Cérebro: texto, link, áudio e o que for compartilhado do WhatsApp.",
  "id": "/capturar",
  "start_url": "/capturar",
  "scope": "/",
  "display": "standalone",
  "orientation": "portrait",
  "lang": "pt-BR",
  "background_color": "#ffffff",
  "theme_color": "#7c6cf0",
  "icons": [
    { "src": "/cerebro-app/icone-192.png", "sizes": "192x192", "type": "image/png" },
    { "src": "/cerebro-app/icone-512.png", "sizes": "512x512", "type": "image/png" },
    { "src": "/cerebro-app/icone-maskable-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" }
  ],
  "shortcuts": [
    { "name": "Gravar áudio", "url": "/capturar?gravar=1" },
    { "name": "Grafo", "url": "/capturar?aba=grafo" }
  ],
  "share_target": {
    "action": "/capturar/compartilhar",
    "method": "POST",
    "enctype": "multipart/form-data",
    "params": {
      "title": "titulo",
      "text": "texto",
      "url": "link",
      "files": [
        {
          "name": "arquivos",
          "accept": ["audio/*", "image/*", "video/*", "application/pdf", "text/plain", ".opus", ".ogg", ".m4a"]
        }
      ]
    }
  }
}
